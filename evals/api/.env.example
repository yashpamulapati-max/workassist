# Copy to .env.local (gitignored) — never commit secrets.

# Preferred: paste a short-lived bearer from docs "Test Request" or Studio session
EVALS_BEARER_TOKEN=

# Or TID client credentials (scopes must include whatever evals requires)
# TID_CLIENT_ID=
# TID_CLIENT_SECRET=
# TID_TOKEN_URL=https://id.trimble.com/oauth/token
# TID_SCOPE=openid agents

EVALS_BASE_URL=https://evals.stage.trimble-ai.com
# Prod docs URL is evals.ai.trimble.com — that needs a prod id.trimble.com token (different aud).
# Stage Agent Studio tokens (stage.id.trimblecloud.com) use evals.stage.trimble-ai.com.
# If auto OpenAPI fetch fails, download from developer portal and set:
# EVALS_OPENAPI_URL=
# or: python3 discover_evals_api.py --openapi-file ./openapi.json

WORK_ASSIST_AGENT_ID=37242c15-9716-4b91-9032-e8f7390d1d80

# Only if create-dataset schema marks kbLibraryLinks required:
# EVALS_KB_LIBRARY_LINKS=uuid-1,uuid-2

# Only after you inspect successCriteria schema — raw JSON array/object, no guessing 0.05 vs 5:
# EVALS_SUCCESS_CRITERIA_JSON=
# EVALS_SUCCESS_CRITERIA_FILE=

# Optional evaluator UUID for smoke job:
# EVALS_EVALUATOR_ID=
